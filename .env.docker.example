# ═════════════════════════════════════════════════════════════════════════
# Vendra — docker compose environment (SPEC §9.1)
#   cp .env.docker.example .env.docker
#   → set the FOUR remote-dependency keys below, leave the rest as-is.
# NEVER commit .env.docker (it is gitignored).
# ═════════════════════════════════════════════════════════════════════════

# ── The four remote-dependency keys (the ONLY thing you must fill in) ──────
# Everything runs locally except two egress-only remote dependencies:
#  1. the Anthropic API (the model the Claude Code harness drives), and
#  2. Vercel Sandbox (the disposable MicroVM the harness executes in —
#     works from any machine; create a token at vercel.com → Account →
#     Tokens, and take team/project ids from any Vercel project's settings).
# Without them the app still boots, serves both surfaces, and accepts
# uploads; documents queue and /api/health reports harness: unconfigured.
ANTHROPIC_API_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ── Database / auth (compose-internal defaults — leave as-is) ──────────────
VENDOR_DATABASE_URL=postgresql://vendor:vendor@postgres:5432/vendra
# Any random 32+ char string; generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret
APP_URL=http://localhost:3000

# ── Object storage (MinIO in compose — leave as-is) ────────────────────────
# TWO endpoints because SigV4 signs the host: the server talks to minio:9000
# in-network; the BROWSER uploads to presigned URLs on localhost:9000.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
VENDOR_DOCS_BUCKET=vendor-docs

# ── Harness tuning (recommended defaults) ───────────────
HARNESS_MODEL=claude-sonnet-4-6
HARNESS_EFFORT_LEVEL=high
HARNESS_MAX_CONCURRENCY=3

# ── Product knobs ──────────────────────────────────────────────────────────
# high = live agent activity feed on the vendor's document cards
VENDOR_AGENT_VERBOSITY=high
# Seed the demo org + logins on first boot (idempotent; credentials print
# to the migrate service's log)
VENDOR_SEED_ON_BOOT=true
# Optional test levers (unset = production defaults):
# VENDOR_SWEEP_INTERVAL_MS=60000
# VENDOR_CONFIRMATION_WINDOW_MS=300000
