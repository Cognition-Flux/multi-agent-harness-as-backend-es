#!/usr/bin/env bash
# Gate a push on the executable specification (SPEC §23.12).
#
# Activate once per clone:
#   pnpm hooks:install        (= git config core.hooksPath .githooks)
#
# Runs the full Rego/wasm invariant suite (policy/run-checks.sh — fmt, strict
# compile, six capability-pinned test groups, artifact integrity, engine
# invariants) and the app type-check. Requires the local opa binary the suite
# already depends on (~/.local/bin/opa or $OPA).
#
# Emergency escape hatch (use sparingly, the suite exists for a reason):
#   VENDRA_SKIP_CHECKS=1 git push
set -euo pipefail

if [ "${VENDRA_SKIP_CHECKS:-0}" = "1" ]; then
  echo "pre-push: checks skipped (VENDRA_SKIP_CHECKS=1)"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"

bash "$ROOT/policy/run-checks.sh"
pnpm --filter vendra type-check
